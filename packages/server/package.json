{
  "name": "@gfy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run db:local && wrangler dev --port 8787 --ip 127.0.0.1",
    "db:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:wrangler": "wrangler deploy --dry-run --outdir dist",
    "smoke": "node scripts/smoke.mjs",
    "e2e:serve": "rm -rf .wrangler/e2e && wrangler d1 migrations apply DB --local --persist-to .wrangler/e2e && wrangler dev --port 8787 --ip 127.0.0.1 --persist-to .wrangler/e2e"
  },
  "dependencies": {
    "@gfy/catalog": "workspace:*",
    "@gfy/imaging": "workspace:*",
    "@gfy/schema": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.151.1"
  }
}
