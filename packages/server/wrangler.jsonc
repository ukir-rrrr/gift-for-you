// Production still needs real D1/R2 ids, a domain, real providers, and secrets (docs/phase3.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gift-for-you",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../player/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*", "/r/*", "/g/*", "/admin", "/admin/*", "/legal/*", "/support", "/webhooks/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gift-for-you",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "gift-for-you-photos" }],
  "triggers": { "crons": ["17 * * * *"] },
  // Deployed defaults fail closed: no provider is configured, so publishing answers 503 until real
  // ones exist. Local runs switch the mocks on with --var (see package.json "dev" and "e2e:serve").
  // Production values: MODERATION "vision", PURCHASE "revenuecat", NOTIFIER "expo", SIGNIN "oidc".
  // Secrets (GOOGLE_VISION_API_KEY, REVENUECAT_SECRET_KEY, REVENUECAT_WEBHOOK_AUTH, EXPO_ACCESS_TOKEN,
  // ADMIN_TOKEN, HASH_SALT) go in with `wrangler secret put`, never here.
  "vars": {
    "PUBLIC_ORIGIN": "",
    "MODERATION": "none",
    "PURCHASE": "none",
    "NOTIFIER": "none",
    "SIGNIN": "none",
    "SUPPORT_EMAIL": "",
    "APPLE_AUDIENCE": "",
    "GOOGLE_AUDIENCES": "",
    "REPORT_HIDE_THRESHOLD": "3",
    // "1" on purpose: App Review buys with sandbox accounts. Sandbox purchases are counted apart in /admin.
    "REVENUECAT_ALLOW_SANDBOX": "1"
  },
  "observability": { "enabled": true }
}
