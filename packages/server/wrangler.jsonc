// Local development config. Production needs real ids, a domain, and non-mock providers (docs/phase2.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gift-for-you",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../player/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*", "/r/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gift-for-you",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "gift-for-you-photos" }],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787",
    "CORS_ORIGINS": "http://127.0.0.1:8081,http://localhost:8081",
    "MODERATION": "mock",
    "PURCHASE": "sandbox-mock",
    "NOTIFIER": "mock",
    "MOCK_INSPECT": "1"
  },
  "observability": { "enabled": true }
}
