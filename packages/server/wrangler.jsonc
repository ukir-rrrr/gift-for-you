// Production still needs real D1/R2 ids, a domain, and real providers (docs/phase2.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gift-for-you",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../player/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*", "/r/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gift-for-you",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "gift-for-you-photos" }],
  "triggers": { "crons": ["17 * * * *"] },
  // Deployed defaults fail closed: no provider is configured, so publishing answers 503 until real
  // ones exist. Local runs switch the mocks on with --var (see package.json "dev" and "e2e:serve").
  "vars": {
    "PUBLIC_ORIGIN": "",
    "MODERATION": "none",
    "PURCHASE": "none",
    "NOTIFIER": "none"
  },
  "observability": { "enabled": true }
}
